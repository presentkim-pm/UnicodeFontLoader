{
  "name": "presentkim/unicodefontloader",
  "description": "Automatically loads unicode font images and packs them into a resource pack, for axolotl-pm/PocketMine-MP",
  "type": "project",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "ext-gd": "*",
    "ext-zip": "*",
    "presentkim/resourcepack-register": "^2.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\unicodefontloader\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\unicodefontloader\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
